# Use a BSC archive-capable RPC for registry backfill. Public dataseeds disable eth_getLogs.
BSC_RPC_URL=

# PostgreSQL connection string for the append-only evidence store.
DATABASE_URL=postgres://aiki:aiki@localhost:5432/aiki

# Canonical ERC-8004 BSC registration deployment range; configurable for controlled backfills.
ERC8004_INITIAL_BLOCK=79027200

# Optional: 8004scan remains a supplemental source, never the authoritative index.
EIGHT004SCAN_API_KEY=

# Required only once the reference agent has a public HTTPS deployment and ERC-8004 token id.
REFERENCE_AGENT_BASE_URL=
VENUS_GUARDIAN_AGENT_ID=
PANCAKE_REBALANCER_AGENT_ID=
PANCAKE_GRID_AGENT_ID=
YIELD_OPTIMIZER_AGENT_ID=

# ── Required in production (apps/api refuses to start without these) ──────────

# Stable Ed25519 seed, 32 bytes of hex. Receipts outlive the process that signs
# them, so a generated key would invalidate every prior receipt on each restart.
#   openssl rand -hex 32
RECEIPT_SIGNING_KEY=

# What makes a session cookie unforgeable. At least 32 characters.
#   openssl rand -base64 48
SESSION_SECRET=

# The host a sign-in message must name. A signature naming any other domain is
# refused, which is what stops a signature collected elsewhere being replayed here.
AUTH_DOMAIN=useaiki.xyz

# The one browser origin allowed to send its session cookie to this API. Its host
# must equal AUTH_DOMAIN, and the API's own public host must be the same site as
# this origin: the session cookie is SameSite=Lax, so a cross-site API host
# (an *.up.railway.app URL against a useaiki.xyz app, say) means sign-in appears
# to succeed and then every authenticated request is quietly a 401.
WEB_ORIGIN=https://useaiki.xyz

# ── Evidence scheduler (apps/api scheduler) ──────────────────────────────────
INDEX_INTERVAL_MS=300000
PROBE_INTERVAL_MS=1800000
PROBE_LIMIT=200
PROBE_CONCURRENCY=6
PROBE_BUDGET_MS=600000
PROBE_STALE_HOURS=24

# ── Web ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.useaiki.xyz
