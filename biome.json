{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!apps/web/.next-build-qa",
      "!.gstack",
      "!**/node_modules",
      "!**/next-env.d.ts",
      "!**/.vercel",
      "!**/.superpowers",
      "!research/_raw",
      "!packages/contracts/src/fixtures/_real",
      "!pnpm-lock.yaml",
      "!**/*.css",
      "!**/probe-sweep-*.json",
      "!onchain/out",
      "!onchain/cache",
      "!onchain/lib",
      "!onchain/broadcast"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
